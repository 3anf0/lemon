<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Speech bubble text — visible when Lemon is speaking -->
    <LinearLayout
        android:id="@+id/speech_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/speech_bubble_bg"
        android:padding="10dp"
        android:maxWidth="220dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/speech_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxWidth="200dp"/>

    </LinearLayout>

    <!-- Bubble row: circle + shadow -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <!-- Shadow -->
        <View
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:background="@drawable/bubble_shadow"/>

        <!-- Main circle with app icon -->
        <LinearLayout
            android:id="@+id/bubble_circle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_background"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="8dp">

            <!-- App icon instead of emoji -->
            <ImageView
                android:id="@+id/bubble_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="Lemon"/>

        </LinearLayout>

        <!-- Pulse ring shown when listening -->
        <View
            android:id="@+id/pulse_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_pulse"
            android:visibility="gone"/>

        <!-- M badge -->
        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bubble_badge"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </FrameLayout>

</LinearLayout>
